{
    "version": "1.0",
    "name": "Development Tools",
    "description": "Common development tools and utilities",
    "packages": [
        {
            "name": "Git",
            "type": "version_control",
            "description": "Distributed version control system",
            "install_command": "sudo apt-get install -y git"
        },
        {
            "name": "Docker",
            "type": "container",
            "description": "Container platform",
            "install_command": "sudo apt-get install -y docker.io"
        },
        {
            "name": "Visual Studio Code",
            "type": "editor",
            "description": "Code editor with debugging support",
            "install_command": "sudo snap install --classic code"
        }
    ]
}
