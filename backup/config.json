{
    "name": "Automator",
    "version": "1.0",
    "update_url": "https://raw.githubusercontent.com/AROA-DEV/Automator/refs/heads/Beta-testing/config.json",
    "instruction_files": {
        "development": {
            "name": "Server",
            "remote_url": "https://raw.githubusercontent.com/AROA-DEV/Automator/refs/heads/Beta-testing/instructions/dev-tools.json",
            "local_path": "instructions/dev-tools.json",
            "local_version": "1.0",
            "auto_update": true
        },
        "media": {
            "name": "Media Tools",
            "remote_url": "https://raw.githubusercontent.com/AROA-DEV/Automator/refs/heads/Beta-testing/instructions/media-tools.json",
            "local_path": "instructions/media-tools.json",
            "local_version": "0.0",
            "auto_update": true
        }
    },
    "settings": {
        "auto_update": true,
        "verify_checksums": true,
        "instructions_cache_dir": "instructions",
        "error_handling": {
            "max_retry_attempts": 3,
            "retry_delay_ms": 5000,
            "connection_timeout_ms": 10000,
            "fallback_config_path": "backup/config.json",
            "offline_mode_on_failure": true
        }
    }
}